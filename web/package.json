{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preflight": "node --import tsx scripts/preflight.mjs && npm run test:moat && npm run schema:guard",
    "ship": "npm run preflight && npm run fixtures && npm run build && npm run color:check && npm run smoke && git push origin main",
    "fixtures": "node scripts/fixtures-all.mjs",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "test:moat": "node --import tsx --test lib/__tests__/*.test.ts",
    "schema:dump": "node --import tsx scripts/schema-dump.mjs",
    "env:example": "./scripts/env-example.sh",
    "schema:guard": "node scripts/schema-guard.mjs",
    "color:check": "node scripts/color-inventory.mjs",
    "color:save": "node scripts/color-inventory.mjs --save",
    "acq:metrics": "node --import tsx scripts/acquisition-metrics.mjs",
    "acq:verify": "node --import tsx scripts/acquisition-verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "maplibre-gl": "5.24.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
