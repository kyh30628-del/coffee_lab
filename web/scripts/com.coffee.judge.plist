<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 04:00 Sonnet 판정 배치 실행. 설치:
     1) 경로를 본인 환경에 맞게 수정(아래 run-judge.sh 절대경로)
     2) cp scripts/com.coffee.judge.plist ~/Library/LaunchAgents/
     3) launchctl load ~/Library/LaunchAgents/com.coffee.judge.plist
     해제: launchctl unload ~/Library/LaunchAgents/com.coffee.judge.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coffee.judge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wangwida/coffee-platform/web/scripts/run-judge.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/coffee-judge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/coffee-judge.err.log</string>
</dict>
</plist>
