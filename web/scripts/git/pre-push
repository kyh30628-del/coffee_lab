#!/bin/bash
# 🌙 저녁 배포 차단 — CEO 지시(2026-09-09) "새벽시간에 재우라니까".
#
# 왜: Vercel 배포는 ISR 캐시를 통째로 비운다. 공개 카페가 23,362곳이라
#   그 뒤 크롤러가 페이지를 하나씩 다시 만들게 하고, 그 재생성이 전부 DB를 친다.
#   실측(2026-09-09): 저녁에 3번 배포한 다음 새벽(00~07시) /c/[id] 서버리스 호출 15,432회
#   = 시간당 2,204회. 캐시가 데워진 오후 같은 구간은 시간당 535회. **4배.**
#   그래서 DB가 190시간 중 1.1시간밖에 못 잤다.
# 규칙: 17시 이후에는 밀지 않는다. 아침에 묶어서 한 번 민다(기존 '배포는 묶어서'와 같은 취지).
# 긴급이면: URGENT=1 git push
# 🔴 2026-09-10 보강: 처음엔 17시 이후만 막았는데, 그러면 **새벽에 미는 건 통과**한다.
#   새벽 배포는 저녁 배포보다 나쁘다 — ISR 캐시가 비워진 채로 남은 새벽을 크롤러가 훑는다.
#   허용 창은 08~17시 하나뿐이다. 재생성 폭풍이 낮에 끝나고 새벽이 조용해진다.
# 🌅 2026-10-17 창 확대 08시 → 06시(CEO "배포창 무조건 아침 6시에 자동으로 시작해").
#   근거 실측(traffic_events 최근 7일 시간대별): 00~23시 **전 시간대가 7/7일 가동**이다 —
#   DB는 새벽에도 자지 않는다(공개 API를 봇이 24시간 깨움). 위에 적힌 "새벽에 재운다"는 전제는 깨졌다.
#   한편 06·07시는 사람 트래픽 최저(114·128회 vs 낮 피크 535회)라 재생성 폭풍이 사람 전에 끝난다.
#   06시 자동 배포는 web/scripts/dawn-deploy.sh(launchd com.coffee.dawn-deploy)가 창 안에서 돈다.
H=$(TZ=Asia/Seoul date +%H)
if [ -z "$URGENT" ] && { [ "$H" -ge 17 ] || [ "$H" -lt 6 ]; }; then
  echo "⛔ 지금은 $(TZ=Asia/Seoul date '+%H:%M') KST — 배포 허용 시간이 아니다(06~17시만)." >&2
  echo "   배포하면 ISR 캐시가 비워지고, 그 재생성이 새벽에 몰려 DB가 못 잔다(실측 4배)." >&2
  echo "   06~17시에 묶어서 밀 것. 진짜 긴급이면: URGENT=1 git push" >&2
  exit 1
fi
exit 0
