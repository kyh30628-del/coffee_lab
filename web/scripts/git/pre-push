#!/bin/bash
# 🌙 저녁 배포 차단 — CEO 지시(2026-09-09) "새벽시간에 재우라니까".
#
# 왜: Vercel 배포는 ISR 캐시를 통째로 비운다. 공개 카페가 23,362곳이라
#   그 뒤 크롤러가 페이지를 하나씩 다시 만들게 하고, 그 재생성이 전부 DB를 친다.
#   실측(2026-09-09): 저녁에 3번 배포한 다음 새벽(00~07시) /c/[id] 서버리스 호출 15,432회
#   = 시간당 2,204회. 캐시가 데워진 오후 같은 구간은 시간당 535회. **4배.**
#   그래서 DB가 190시간 중 1.1시간밖에 못 잤다.
# 규칙: 17시 이후에는 밀지 않는다. 아침에 묶어서 한 번 민다(기존 '배포는 묶어서'와 같은 취지).
# 긴급이면: URGENT=1 git push
H=$(TZ=Asia/Seoul date +%H)
if [ -z "$URGENT" ] && [ "$H" -ge 17 ]; then
  echo "⛔ 지금은 $(TZ=Asia/Seoul date '+%H:%M') KST — 저녁 배포 차단." >&2
  echo "   배포하면 ISR 캐시가 비워지고, 그 재생성이 새벽에 몰려 DB가 못 잔다(실측 4배)." >&2
  echo "   아침에 묶어서 밀 것. 진짜 긴급이면: URGENT=1 git push" >&2
  exit 1
fi
exit 0
