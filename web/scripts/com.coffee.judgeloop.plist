<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 판정+그라운딩을 ~3시간마다(01·07·10·13·16·19·22시) 실행 → Max 리셋 빨리 잡아 backlog 자동 수렴.
     새벽(01,04시)=풀 사용, 낮=~70% 캡. 04:00 본배치(com.coffee.judge)는 promo·youtube 포함.
     load: launchctl load ~/Library/LaunchAgents/com.coffee.judgeloop.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coffee.judgeloop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wangwida/coffee-platform/web/scripts/run-judgeloop.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/coffee-judgeloop.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/coffee-judgeloop.err.log</string>
</dict>
</plist>
