<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 새벽 00:30·02:30·04:30에만 판정 풀 실행(00:30~06:00 창). 낮엔 안 돔(토큰 절약).
     한도 시 중단 → 다음 새벽 슬롯이 이어감. load: launchctl load ~/Library/LaunchAgents/com.coffee.judgeloop.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coffee.judgeloop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wangwida/coffee-platform/web/scripts/run-judgeloop.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/coffee-judgeloop.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/coffee-judgeloop.err.log</string>
</dict>
</plist>
