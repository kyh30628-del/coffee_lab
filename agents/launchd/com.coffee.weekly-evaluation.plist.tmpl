<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.coffee.weekly-evaluation</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__COFFEE_ROOT__/agents/run-weekly.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__COFFEE_ROOT__/agent-reports/support-weekly.err</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
