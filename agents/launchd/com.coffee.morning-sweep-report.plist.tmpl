<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.coffee.morning-sweep-report</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__COFFEE_ROOT__/agents/run-morning-sweep-report.sh</string></array>
  <key>StartCalendarInterval</key>
  <array><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict></array>
  <key>StandardOutPath</key><string>/tmp/coffee-morning-sweep.out</string>
  <key>StandardErrorPath</key><string>/tmp/coffee-morning-sweep.err</string>
</dict>
</plist>
