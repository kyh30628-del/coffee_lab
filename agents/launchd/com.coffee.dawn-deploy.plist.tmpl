<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.coffee.dawn-deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__COFFEE_ROOT__/web/scripts/dawn-deploy.sh</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__COFFEE_ROOT__/agent-reports/logs/dawn-deploy.out</string>
  <key>StandardErrorPath</key><string>__COFFEE_ROOT__/agent-reports/logs/dawn-deploy.err</string>
</dict>
</plist>
