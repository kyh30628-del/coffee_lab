<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.coffee.sangga-rollout</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>__COFFEE_ROOT__/agents/run-sangga-rollout.sh</string>
  </array>
  <key>StartCalendarInterval</key><array><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict></array>
  <key>StandardOutPath</key><string>/tmp/sangga-rollout.out</string>
  <key>StandardErrorPath</key><string>/tmp/sangga-rollout.err</string>
</dict></plist>
