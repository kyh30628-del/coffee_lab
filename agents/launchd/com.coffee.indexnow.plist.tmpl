<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.coffee.indexnow</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__COFFEE_ROOT__/agents/run-indexnow.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__COFFEE_ROOT__/agent-reports/indexnow.err</string>
	<key>StandardOutPath</key>
	<string>__COFFEE_ROOT__/agent-reports/indexnow.out</string>
	<key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>40</integer></dict>
  </array>
</dict>
</plist>
